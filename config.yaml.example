# AutoRename Configuration (v2)
# Copy this file to config.yaml and fill in your values.

# AI Provider Configuration
ai:
  provider: "openai"              # openai, anthropic, gemini, xai, ollama
  model: "${OPEN_SHARED_MODEL}"   # Set OPEN_SHARED_MODEL in the user environment
  api_key: "${OPENAI_API_KEY}"    # Not needed for ollama
  base_url: ""                    # Custom base URL (optional, for proxies)
  temperature: 0.0                # 0.0 = deterministic
  max_retries: 2                  # Retry failed API calls

# --- API Key Options ---
# You can store your API key in two ways:
#
# Method 1 — Directly in this file (simple, portable):
#   api_key: "sk-your-actual-key-here"
#
# Method 2 — Via environment variable (secure, easy to switch):
#   api_key: "${OPENAI_API_KEY}"
#
# With Method 2, set the variable in a .env file next to this config:
#   OPENAI_API_KEY=sk-your-actual-key-here
#   ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# Any string value in this file can reference env vars with ${VAR_NAME}.
# See .env.example for a template.

# PDF Processing
pdf:
  max_pages: 3                    # Max pages to process per PDF
  ocr: "auto"                     # false / true / "auto" — PaddleOCR for scanned PDFs
  vision: false                   # false / true / "auto" — send page images to LLM
  text_quality_threshold: 0.3     # embedded-text threshold for OCR readiness
  outgoing_invoice: "AR"          # Abbreviation for outgoing invoices (Accounts Receivable)
  incoming_invoice: "ER"          # Abbreviation for incoming invoices (Expense Reports)

# Standalone Image Processing (macOS Apple Vision)
image:
  apple_vision: true              # OCR image files locally with Apple Vision when available
  apple_vision_recognition_level: "accurate"  # accurate / fast
  apple_vision_language_correction: true
  apple_vision_languages: ["en-US"]
  apple_vision_classify: true     # Add built-in Vision image classification labels as hints
  apple_vision_max_classifications: 8
  apple_vision_min_confidence: 0.15
  llm_vision: false               # Also send image pixels to the configured LLM
  screenshot_mode: "auto"          # Add UI-screenshot context for screenshot-like filenames
  coreml_model_path: ""           # Optional .mlmodelc path for VNCoreMLRequest hints
  coreml_max_observations: 10

# Generic archival normalization. Private route destinations do NOT belong here.
normalization:
  persistent_ocr: "auto"          # auto / always / never
  ocrmypdf_command: "ocrmypdf"     # executable name or absolute path
  ocrmypdf_mode: "skip"            # preserves pages that already contain text
  ocrmypdf_args: []                # optional extra OCRmyPDF CLI args
  keep_original_before_ocr: false
  original_backup_dir: ".autorename-originals"
  min_confidence: 0.85             # processing/review threshold; routing can impose a stricter private threshold
  review_on_ocr_failure: true
  min_file_age_seconds: 30         # avoid partially copied/scanned files
  audit_db: "~/.local/share/autorename/audit.sqlite3"
  categories:
    - identity_immigration
    - finance_tax
    - education
    - medical
    - vehicle_insurance
    - housing
    - employment
    - legal
    - other

# PaddleOCR Configuration (optional, install via setup.ps1/setup.sh)
paddleocr:
  venv_path: ""                   # Auto-detected if empty
  language: "en"                   # OCR language code (one language per instance)
                                   #   "en" = English-only model (smaller, faster)
                                   #   "de","fr","es",etc. = Latin model (all 59 Latin-script langs incl. English)
                                   #   "ch" = Chinese model (also handles Japanese and English)
                                   #   For European docs, use your country code -- it covers English too.
  device: "cpu"                   # auto / cpu / gpu
  # detection_model: ""           # Detection model (default: PP-OCRv5_mobile_det)
                                  #   Use "PP-OCRv5_server_det" for higher accuracy
                                  #   on complex layouts (uses more RAM)
  # det_limit_side_len: 736       # Max image side for detection (lower = less RAM)
  # cpu_threads: 4                # CPU threads for OCR inference (default: 4)

# Company Information
company:
  name: "Your Company Name"       # Your company name (prevents it being extracted as counterparty)

# Output Settings
output:
  language: "English"             # Language for document type descriptions
  date_format: "%Y%m%d"          # strftime format for filenames (YYYYMMDD)
  use_source_timestamp_fallback: true        # Use timestamp from source filename when AI finds no date
  preserve_source_timestamp_for_images: true # Convert screenshot timestamps to compact YYYYMMDD_HHMMSS prefixes
  omit_unknown_components: true              # Omit weak values like Unknown instead of writing them
  skip_when_no_substantial_description: true # Leave timestamp-only screenshots unchanged if AI only says "screenshot"

# Downloads organization. Agy is tried first for ambiguous destination choices;
# sandboxed Codex Luna is the fallback. Remove either name to disable it.
organize:
  recognition_backends: ["agy", "codex"]
  recognition_timeout: 60
  maximum_files: 100

# Optional AI Prompt Extension
# Add custom instructions to fine-tune extraction, e.g.:
# prompt_extension: 'If it is an incoming or outgoing invoice, add the total amount like "ER 1234,56".'
prompt_extension: ""
