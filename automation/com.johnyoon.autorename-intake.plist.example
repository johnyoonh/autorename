<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.johnyoon.autorename-intake</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO/.venv/bin/python</string>
    <string>REPO/autorename-pdf.py</string>
    <string>organize</string>
    <string>intake</string>
    <string>HOME/Downloads</string>
    <string>--apply</string>
    <string>--output</string>
    <string>json</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>HOME/Library/Logs/autorename-intake.json</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Logs/autorename-intake-error.log</string>
</dict>
</plist>
