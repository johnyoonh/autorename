<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.johnyoon.autorename-downloads</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO/.venv/bin/python</string>
    <string>REPO/autorename-pdf.py</string>
    <string>organize</string>
    <string>run</string>
    <string>HOME/Downloads</string>
    <string>--destination</string>
    <string>HOME/Archives/Downloads</string>
    <string>--older-than</string>
    <string>30</string>
    <string>--apply</string>
    <string>--skip-pdf-renaming</string>
    <string>--output</string>
    <string>json</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key>
  <string>HOME/Library/Logs/autorename-downloads.json</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Logs/autorename-downloads-error.log</string>
</dict>
</plist>
