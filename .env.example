# AutoRename-PDF — Test Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# OpenAI API key (for live integration tests)
OPENAI_API_KEY=sk-your-openai-key

# Shared OpenAI model used by application config and live tests
OPEN_SHARED_MODEL=gpt-5.6

# Anthropic API key (for live integration tests)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Ollama model (for local AI tests, default: qwen3:4b)
OLLAMA_MODEL=qwen3:4b
